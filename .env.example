# Скопируйте в .env и заполните значения: cp .env.example .env
# --- Общее ---
ENV=development
HTTP_PORT=80

# --- PostgreSQL ---
POSTGRES_USER=atelier
POSTGRES_PASSWORD=change_me
POSTGRES_DB=atelier
DATABASE_URL=postgresql+asyncpg://atelier:change_me@db:5432/atelier

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Backend (FastAPI) ---
SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost

# --- Frontend (Nuxt) ---
NUXT_PUBLIC_API_BASE=http://localhost/api
